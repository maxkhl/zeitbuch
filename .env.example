# ---- Docker Compose ----------------------------------------------------------
# Adresse:Port auf dem Host. Default nur lokal; läuft der Nginx Proxy Manager auf
# einem anderen Host, die LAN-IP eintragen und per Firewall auf den NPM beschränken.
ZEITBUCH_PUBLISH=127.0.0.1:8000

# ---- Betrieb -----------------------------------------------------------------
# Port im Container (docker-compose.yml setzt 8000; nur für lokalen Start)
ZEITBUCH_PORT=8000
# Bind-Adresse von waitress im Container
ZEITBUCH_BIND=0.0.0.0
# SQLite-Datenbank, muss im Volume /data liegen
ZEITBUCH_DB=/data/zeitbuch.db
# auto = je System echt, wenn URL und Zugang gesetzt sind, sonst Mock (Banner in
# der UI). real = beide Systeme echt, fehlende Angaben sind ein Startfehler.
# mock = beide simuliert. Im Betrieb "real", damit nichts still im Mock landet.
ZEITBUCH_BACKEND=real
# Zeitlimit für API-Aufrufe in Sekunden
ZEITBUCH_HTTP_TIMEOUT=20
ZEITBUCH_LOG_LEVEL=INFO

# ---- YouTrack ----------------------------------------------------------------
# Basis-URL ohne /api, z. B. https://youtrack.example.org
ZEITBUCH_YOUTRACK_URL=
# Permanent Token eines eigenen Benutzers mit NUR Leserechten
ZEITBUCH_YOUTRACK_TOKEN=

# ---- Dolibarr ----------------------------------------------------------------
# Basis-URL der Weboberfläche ohne /api, z. B. https://dolibarr.example.org
ZEITBUCH_DOLIBARR_URL=
# API-Key eines eigenen Benutzers, Rechte nur auf Projekte/Aufgaben/Zeiten
ZEITBUCH_DOLIBARR_KEY=

# ---- YouTrack-Feldkonfiguration (Defaults laut Konzept) -----------------------
ZEITBUCH_YT_FIELD_TYPE=Type
ZEITBUCH_YT_TYPE_PROJECT=Abrechnungsprojekt
ZEITBUCH_YT_TYPE_POSITION=Abrechnungsposition
ZEITBUCH_YT_FIELD_EXT_PROJECT=Ext-Projekt
ZEITBUCH_YT_FIELD_EXT_POSITION=Ext-Position
ZEITBUCH_YT_FIELD_BOOKABLE=Bebuchbar
ZEITBUCH_YT_FIELD_COORDINATION=Abstimmung
ZEITBUCH_YT_VALUE_YES=ja
ZEITBUCH_YT_WORK_IMPLEMENTATION=Umsetzung
ZEITBUCH_YT_WORK_MEETING=Besprechung
ZEITBUCH_YT_WORK_NONBILLABLE=Nicht abrechenbar
# Kommagetrennte Logins, deren Work Items zählen; leer = alle
ZEITBUCH_YT_AUTHORS=
